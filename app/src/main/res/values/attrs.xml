<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="backButtonVisibility">
        <!-- Visible on screen; the default value. -->
        <enum name="visible" value="0" />
        <!-- Not displayed, but taken into account during layout (space is left for it). -->
        <enum name="invisible" value="1" />
        <!-- Completely hidden, as if the view had not been added. -->
        <enum name="gone" value="2" />
    </attr>

    <declare-styleable name="LoadingComponent">
        <attr name="loadingBackground" format="color"/>
    </declare-styleable>

    <declare-styleable name="BaseToolbar">
        <attr name="backButtonVisibility"/>
    </declare-styleable>

    <declare-styleable name="ButtonComponent">
        <attr name="android:textColor"/>
        <attr name="android:text"/>
    </declare-styleable>

    <declare-styleable name="DeveloperButtonComponent">
        <attr name="titleText" format="string"/>
        <attr name="subtitleText" format="string"/>
        <attr name="valueText" format="string"/>
        <attr name="hasSwitch" format="boolean"/>
    </declare-styleable>
</resources>